# Variables del proyecto Vercel de la beta privada (TODOS los entornos). Solo estas tres. Sin valores reales en el repositorio.
# Valores: Supabase del proyecto NUEVO e independiente (Project Settings > API). Nunca los de Production (psbvqdaksrfrkxbewrll).
NEXT_PUBLIC_SUPABASE_URL=https://<ref-del-proyecto-nuevo>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<clave publishable (sb_publishable_...) del proyecto nuevo>
NEXT_PUBLIC_CEREBRO_BETA=private
# NO definir: service role, CRON_SECRET, FAL/OpenAI/Gemini/ElevenLabs/etc., OAuth, R2. El arranque se niega si existen.
