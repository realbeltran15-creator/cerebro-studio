NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Separate key with /v1/audio/speech permission; never expose to browser.
OPENAI_VOICE_API_KEY=
IMAGE_FALLBACK_ENDPOINT=
IMAGE_FALLBACK_API_KEY=
# ElevenLabs (voice + sound effects). Server-only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
VOICE_PROVIDER_ENDPOINT=
VOICE_PROVIDER_API_KEY=
VOICE_FALLBACK_ENDPOINT=
VOICE_FALLBACK_API_KEY=
# Server-only fal.ai API key for fixed 5s 480P smoke test.
FAL_KEY=
VIDEO_PROVIDER_ENDPOINT=
VIDEO_PROVIDER_API_KEY=
VIDEO_FALLBACK_ENDPOINT=
VIDEO_FALLBACK_API_KEY=
RENDER_WORKER_URL=
RENDER_WORKER_TOKEN=
# Server-only YouTube Data API v3 key (research search; read-only, no OAuth).
YOUTUBE_API_KEY=
# Optional dedicated key for script assistance; falls back to OPENAI_API_KEY.
OPENAI_TEXT_API_KEY=
# Optional model override for script assistance.
OPENAI_TEXT_MODEL=
# Google OAuth client for the owner's YouTube channel (Analytics + optional publishing).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64 (encrypts OAuth tokens at rest).
TOKEN_ENCRYPTION_KEY=
# Daily automations (Vercel Cron). Server-only; never expose the service role key.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# --- Free / freemium providers (Creation Studio) ---
# Cloudflare Workers AI: 10,000 free neurons/day (FLUX.1 schnell images, MeloTTS voice).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Google Gemini API (AI Studio): Gemini TTS has a free tier; Veo 3.1 is paid (official route to Google Flow's models).
GEMINI_API_KEY=
# Free media banks (read-only API keys): sounds with CC licenses, stock photos and videos.
FREESOUND_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Groq (free plan with limits): text (GPT-OSS) and Whisper transcription.
GROQ_API_KEY=
# Optional: OpenAI text model used when the task needs maximum quality (default gpt-4.1-mini).
OPENAI_TEXT_MODEL=
# --- Social publishing (official APIs, OAuth; nothing is published without approval) ---
# Meta app with "Instagram API with Instagram Login". Redirect URI: <origin>/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# TikTok for Developers app with Login Kit + Content Posting API. Redirect URI: <origin>/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# --- Cloud storage for large media (recommended) ---
# Cloudflare R2: 10 GB-month free, free egress, objects up to ~5 TB. Without it, files go to Supabase
# Storage (Free plan: 50 MB per file, 1 GB total). Create an R2 API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# --- Higgsfield (official API, account credits; keys from console.higgsfield.ai) ---
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# --- Own OpenAI-compatible text gateway (OmniRoute, LiteLLM, Ollama…). Must be reachable over HTTPS from the server. ---
TEXT_GATEWAY_BASE_URL=
TEXT_GATEWAY_API_KEY=
TEXT_GATEWAY_MODEL=eco-router
# Quality you trust it with (1–5). Tasks that need more never use it. Default 3.
TEXT_GATEWAY_QUALITY=3
